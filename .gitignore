# Godot 4+ specific ignores
.godot/
**/addons/*
# Our own export plugin, unlike installed addons, is part of the project.
!**/addons/app_version/
/android/
/build/

/docs/
/tools/
design/docs/*.html
design/docs/*.js
design/docs/mages.css

# WIP deepwood enemies, not ready to commit yet
/game/characters/enemies/ent/
/game/characters/enemies/swarm/

# Python bytecode from the design tooling
__pycache__/

# Symlink to the website repo (lownpho.github.io) for editing the game's page here
/webpage

# Symlink to the website repo's mages page
/website/

# The design tooling's own venv, built by design/tools/pre-commit
design/tools/.venv/

# Agent worktrees live inside the repo; git sees each one as a gitlink
.claude/worktrees/

# Agent scratch work (research, issues, prototypes), never committed
/.scratch/
