<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spell Catalogue — Design View</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="mages.css">
</head>
<body class="mages">
<div class="doc">

<header>
  <h1 class="doc-title"><span class="m">S</span>pell Catalogue</h1>
  <p class="doc-sub">Every shipped spell, its words from <code>design/data/spells.yaml</code> and its
    numbers from the game's <code>.tres</code>. See also the
    <a href="spells_balance.html">numbers sheet</a> and the <a href="enemies.html">bestiary</a>.</p>
</header>

<div class="toolbar panel">
  <div class="row">
      <input type="search" id="q" placeholder="Search name or description…" autocomplete="off">
      <label class="lbl" for="sort">Sort</label>
      <select id="sort">
          <option value="cat">Category</option>
          <option value="name">Name</option>
          <option value="cooldown">Cooldown</option>
          <option value="range">Range</option>
          <option value="damage">Damage</option>
          <option value="tiers">Tiers</option>
      </select>
      <span class="count" id="count"></span>
      <button class="btn" id="reset">reset</button>
  </div>
  <div class="facets" id="facets"></div>
</div>

<main>
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty" hidden>No spells match these filters.</div>
</main>

</div>

<script src="data.js"></script>
<script src="mages.js"></script>
<script>
(function () {
  "use strict";
  var D = window.MAGES, el = D.el;
  var CATS = D.categories.map(function (c) { return c.id; });
  var CAT_NAME = {};
  D.categories.forEach(function (c) { CAT_NAME[c.id] = c.name; });
  var BASE = D.constants.base_stats;

  function top(s) { return s.tiers[s.tiers.length - 1]; }
  function amount(t) {
    var a = t.amount;
    if (!a) return 0;
    return a.base + a.skill * BASE.skill + a.speed * BASE.speed + a.defence * BASE.defence;
  }
  function range(s) {
    var p = top(s).projectile;
    return p ? p.range_tiles : 0;
  }

  D.browse({
    items: D.spells,
    noun: "spells",
    facets: [
      { key: "category", label: "Type", order: CATS, vals: function (s) { return [s.category]; },
        chipText: function (id) { return CAT_NAME[id] || id; } },
      { key: "kind", label: "Family", vals: function (s) { return [s.kind]; } },
      { key: "hold", label: "Hold", order: ["no", "charged", "channeled"],
        vals: function (s) { return [s.hold]; } },
      { key: "scaling", label: "Scales with", vals: function (s) { return s.scaling; } },
      { key: "grants", label: "Grants", vals: function (s) { return s.grants; } }
    ],
    search: function (s) { return s.id + " " + s.name + " " + s.description + " " + s.per_tier; },
    sorts: {
      cat: function (a, b) {
        return CATS.indexOf(a.category) - CATS.indexOf(b.category) || a.name.localeCompare(b.name);
      },
      name: function (a, b) { return a.name.localeCompare(b.name); },
      cooldown: function (a, b) { return top(a).cooldown - top(b).cooldown; },
      range: function (a, b) { return range(b) - range(a); },
      damage: function (a, b) { return amount(top(b)) - amount(top(a)); },
      tiers: function (a, b) { return b.tiers.length - a.tiers.length; }
    },
    card: function (s) {
      var head = el("div", "card-head", [
        el("span", "name", s.name),
        el("span", "badge cat-" + s.category, CAT_NAME[s.category]),
        s.hold !== "no" ? el("span", "badge hold", s.hold) : null
      ]);

      var dl = el("dl", "stats");
      function stat(k, v) {
        dl.appendChild(el("dt", null, k));
        dl.appendChild(el("dd", null, v));
      }
      stat("Scales with", s.scaling.join(", "));
      stat("Grants", el("div", "pills", s.grants.map(function (g) {
        var best = Math.max.apply(null, s.tiers.map(function (t) { return (t.grants || {})[g] || 0; }));
        return el("span", "pill", g + " +" + best);
      })));
      stat("Cooldown", top(s).cooldown + "s");
      stat("Cast", top(s).cast_time ? top(s).cast_time + "s" : "instant");
      if (top(s).projectile) stat("Range", range(s) + " tiles");
      if (s.per_tier) stat("Per tier", s.per_tier);

      var tiers = el("div", "tierline", s.tiers.map(function (t) {
        return el("span", "pill tier", "T" + t.tier + " · " + Math.round(amount(t)));
      }));

      return el("article", "card", [head, el("p", "desc", s.description), dl, tiers]);
    }
  });
})();
</script>
</body>
</html>
