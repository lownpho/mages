<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Enemy Catalogue — Design View</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="mages.css">
</head>
<body class="mages">
<div class="doc">

<header>
  <h1 class="doc-title"><span class="m">E</span>nemy Catalogue</h1>
  <p class="doc-sub">Every built enemy, its words from <code>design/data/enemies.yaml</code> and its
    numbers from the game's <code>.tres</code>. See also the <a href="spells.html">spells</a> and
    the <a href="biomes.html">room tables</a>.</p>
</header>

<div class="toolbar panel">
  <div class="row">
      <input type="search" id="q" placeholder="Search name, behaviour, casts, drops…" autocomplete="off">
      <label class="lbl" for="sort">Sort</label>
      <select id="sort">
          <option value="biome">Biome</option>
          <option value="name">Name</option>
          <option value="rarity">Rarity</option>
          <option value="max_health">HP</option>
          <option value="damage_max">Damage</option>
      </select>
      <span class="count" id="count"></span>
      <button class="btn" id="reset">reset</button>
  </div>
  <div class="facets" id="facets"></div>
  <div class="facet fields" id="fields"><span class="flabel">Fields</span></div>
</div>

<main>
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty" hidden>No enemies match these filters.</div>
</main>

</div>

<script src="data.js"></script>
<script src="mages.js"></script>
<script>
(function () {
  "use strict";
  var D = window.MAGES, el = D.el;
  var BIOMES = D.biomes.map(function (b) { return b.id; });
  var RARITY = ["common", "rare", "boss"];

  // Which stat rows the cards show. Toggling them all off collapses the grid
  // into a dense balance table, so the choice is remembered between visits.
  var FIELDS = [
    { key: "description", label: "desc" },
    { key: "hp", label: "hp" },
    { key: "speed", label: "speed" },
    { key: "range", label: "range" },
    { key: "attacks", label: "attacks" },
    { key: "drops", label: "drops" },
    { key: "notes", label: "notes" }
  ];
  // Versioned: renaming a field key must not leave a stale set silently hiding it.
  var STORE = "mages.enemies.fields.v2";
  var shown = new Set(FIELDS.map(function (f) { return f.key; }));
  try {
    var saved = JSON.parse(localStorage.getItem(STORE));
    if (Array.isArray(saved)) shown = new Set(saved);
  } catch (e) { /* file:// without storage — defaults are fine */ }

  var fieldsEl = document.getElementById("fields");
  var redraw = null;
  FIELDS.forEach(function (f) {
    var b = el("button", "chip", f.label);
    b.type = "button";
    b.dataset.field = f.key;
    b.addEventListener("click", function () {
      if (shown.has(f.key)) shown.delete(f.key); else shown.add(f.key);
      syncFields();
      try { localStorage.setItem(STORE, JSON.stringify([].concat([...shown]))); } catch (e) {}
      if (redraw) redraw();
    });
    fieldsEl.appendChild(b);
  });
  function syncFields() {
    Array.prototype.forEach.call(fieldsEl.querySelectorAll(".chip"), function (b) {
      b.setAttribute("aria-pressed", shown.has(b.dataset.field) ? "true" : "false");
    });
    document.getElementById("grid").classList.toggle("dense", !shown.has("description"));
  }
  syncFields();

  /** Render prose that may contain `inline code`. */
  function withCode(text) {
    var frag = document.createDocumentFragment();
    text.split(/(`[^`]+`)/).forEach(function (part) {
      if (part.charAt(0) === "`" && part.charAt(part.length - 1) === "`") {
        frag.appendChild(el("code", null, part.slice(1, -1)));
      } else if (part) {
        frag.appendChild(document.createTextNode(part));
      }
    });
    return frag;
  }

  /** One attack in a phrase: what it hits for, then how it behaves. */
  function attackText(e, a) {
    var bits = [];
    if (a.cooldown) bits.push(a.cooldown + "s cd");
    if (a.shots) {
      var s = a.shots.pattern.replace("Pattern", "");
      if (a.shots.per_shot > 1) s += " x" + a.shots.per_shot;
      if (a.shots.count > 1) s += ", " + a.shots.count + " @ " + a.shots.interval + "s";
      bits.push(s);
    }
    if (a.projectile) bits.push(a.projectile.range_tiles + " tiles");
    (a.behaviours || []).forEach(function (b) { bits.push(b.type); });
    if (a.minion) bits.push(a.minion.count + " minions");
    if (a.absorb) bits.push("absorbs " + a.absorb);
    var dmg = a.amount && a.amount.base ? " " + a.amount.base : "";
    return [a.name + dmg, bits.join(", ")];
  }

  redraw = D.browse({
    items: D.enemies,
    noun: "enemies",
    facets: [
      { key: "biome", label: "Biome", order: BIOMES,
        vals: function (e) { return e.biomes.map(function (b) { return b.id; }); },
        chipText: function (id) {
          var b = D.biomes.filter(function (x) { return x.id === id; })[0];
          return b ? b.name : id;
        } },
      { key: "rarity", label: "Rarity", order: RARITY, vals: function (e) { return [e.rarity]; } },
      { key: "kinds", label: "Kind", vals: function (e) { return e.kinds; } },
      { key: "casts", label: "Casts", vals: function (e) { return e.casts; } },
      { key: "drops", label: "Drops",
        vals: function (e) { return e.drops.map(function (d) { return d.spell; }); } }
    ],
    search: function (e) {
      return e.id + " " + e.description + " " + e.casts.join(" ") + " " + e.notes + " " +
             e.attacks.map(function (a) { return a.cast; }).join(" ") + " " +
             e.drops.map(function (d) { return d.item; }).join(" ");
    },
    sorts: {
      biome: function (a, b) {
        var ra = a.biomes.length ? BIOMES.indexOf(a.biomes[0].id) : 99;
        var rb = b.biomes.length ? BIOMES.indexOf(b.biomes[0].id) : 99;
        return ra - rb || RARITY.indexOf(a.rarity) - RARITY.indexOf(b.rarity)
               || a.id.localeCompare(b.id);
      },
      name: function (a, b) { return a.name.localeCompare(b.name); },
      rarity: function (a, b) {
        return RARITY.indexOf(a.rarity) - RARITY.indexOf(b.rarity) || a.name.localeCompare(b.name);
      },
      max_health: function (a, b) { return b.max_health - a.max_health; },
      damage_max: function (a, b) { return b.damage_max - a.damage_max; }
    },
    card: function (e) {
      var head = el("div", "card-head", [
        D.sprite(e.icon, 3),
        el("span", "name", e.name),
        el("span", "badge rar-" + e.rarity, e.rarity)
      ].concat(e.kinds.map(function (k) { return el("span", "badge k", k); }))
       .concat(e.biomes.map(function (b) {
        return el("span", "badge biome" + (b.planned ? " planned" : ""),
                  b.name + (b.planned ? " (planned)" : ""));
      })));

      var dl = el("dl", "stats");
      function stat(key, label, value) {
        if (!shown.has(key)) return;
        dl.appendChild(el("dt", null, label));
        dl.appendChild(el("dd", null, value));
      }
      // A comma-separated value. An item is either text, or [text, tooltip] — the
      // tooltip is the only thing that distinguishes an entry, never a background.
      function list(items) {
        var frag = document.createDocumentFragment();
        items.forEach(function (t, i) {
          if (i) frag.appendChild(document.createTextNode(", "));
          var s = el("span", null, Array.isArray(t) ? t[0] : t);
          if (Array.isArray(t)) s.title = t[1];
          frag.appendChild(s);
        });
        return frag;
      }
      stat("hp", "HP", String(e.max_health));
      if (e.speed_px) stat("speed", "Speed", e.speed_px + " px/s");
      if (e.probes) {
        stat("range", "Range", list(Object.keys(e.probes).map(function (k) {
          return k + " " + e.probes[k];
        })));
      }
      if (e.attacks.length) {
        stat("attacks", "Attacks", list(e.attacks.map(function (a) { return attackText(e, a); })));
      }
      stat("drops", "Drops", list(e.drops.map(function (d) {
        return d.spell + (d.tier ? " t" + d.tier : "") + " " + Math.round(d.chance * 100) + "%";
      })));

      return el("article", "card", [
        head,
        shown.has("description") ? el("p", "desc", withCode(e.blurb)) : null,
        dl.childNodes.length ? dl : null,
        e.notes && shown.has("notes") ? el("p", "note", e.notes) : null
      ]);
    }
  });
})();
</script>
</body>
</html>
