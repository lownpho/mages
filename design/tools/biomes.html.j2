<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Biome Rooms — Design View</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="mages.css">
<style>
  /* Page-specific only — the rest is the shared mages.css theme. */
  .badge.room { background: var(--cyan); }
  .sub-b { color: var(--grey); margin-left: auto; }
  .vars { display: flex; flex-direction: column; gap: 4px; }
  .var { display: flex; align-items: center; gap: 0.5rem;
         background: var(--bg-deep); color: var(--dim); padding: 0.15rem 0.45rem; }
  .var.empty { color: var(--grey); background: transparent; padding-left: 0; }
  .var .w { font-family: 'Silkscreen', monospace; font-size: 0.5rem; color: var(--grey); }
  .var .pack { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .var .plus { color: var(--grey); }
</style>
</head>
<body class="mages">
<div class="doc">

<header>
  <h1 class="doc-title"><span class="m">B</span>iome Rooms</h1>
  <p class="doc-sub">Every room type the generator can place, read straight out of
    <code>game/world_content/</code>. Each card is one room type; when it is placed it rolls
    <em>one</em> of its variations per enemy group. See also the
    <a href="enemies.html">bestiary</a>.</p>
</header>

<div class="toolbar panel">
  <div class="row">
      <input type="search" id="q" placeholder="Search room or enemy…" autocomplete="off">
      <label class="lbl" for="sort">Sort</label>
      <select id="sort">
          <option value="loc">Biome › tier</option>
          <option value="tier">Tier</option>
          <option value="shape">Shape</option>
          <option value="variations">Variations</option>
      </select>
      <span class="count" id="count"></span>
      <button class="btn" id="reset">reset</button>
  </div>
  <div class="facets" id="facets"></div>
</div>

<main>
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty" hidden>No rooms match these filters.</div>
</main>

</div>

<script src="data.js"></script>
<script src="mages.js"></script>
<script>
(function () {
  "use strict";
  var D = window.MAGES, el = D.el;
  var BIOMES = D.biomes.map(function (b) { return b.id; });
  var ICON = {};
  D.enemies.forEach(function (e) { ICON[e.id] = e; });

  function enemiesIn(r) {
    var seen = {};
    r.variations.forEach(function (v) {
      v.members.forEach(function (m) { if (m.enemy) seen[m.enemy] = true; });
    });
    return Object.keys(seen);
  }

  D.browse({
    items: D.rooms,
    noun: "rooms",
    facets: [
      { key: "biome", label: "Biome", order: BIOMES, vals: function (r) { return [r.biome]; },
        chipText: function (id) {
          var b = D.biomes.filter(function (x) { return x.id === id; })[0];
          return b ? b.name : id;
        } },
      { key: "difficulty", label: "Tier", vals: function (r) { return ["T" + r.difficulty]; } },
      { key: "generator", label: "Shape", vals: function (r) { return [r.generator]; } },
      { key: "enemies", label: "Spawns", vals: enemiesIn }
    ],
    search: function (r) { return r.id + " " + enemiesIn(r).join(" "); },
    sorts: {
      loc: function (a, b) {
        return BIOMES.indexOf(a.biome) - BIOMES.indexOf(b.biome)
               || a.difficulty - b.difficulty || a.id.localeCompare(b.id);
      },
      tier: function (a, b) { return a.difficulty - b.difficulty || a.id.localeCompare(b.id); },
      shape: function (a, b) {
        return a.generator.localeCompare(b.generator) || a.id.localeCompare(b.id);
      },
      variations: function (a, b) { return b.variations.length - a.variations.length; }
    },
    card: function (r) {
      var pinned = r.min_per_biome === r.max_per_biome;
      var head = el("div", "card-head", [
        el("span", "name", r.id.replace(r.biome + "_", "")),
        el("span", "badge room", "T" + r.difficulty),
        el("span", "badge", r.generator),
        el("span", "badge", pinned ? "exactly " + r.min_per_biome : "weight " + r.weight),
        el("span", "sub-b", r.biome_name)
      ]);

      var vars = el("div", "vars");
      if (!r.variations.length) {
        vars.appendChild(el("div", "var empty", "(empty — this room spawns nothing)"));
      }
      r.variations.forEach(function (v) {
        var pack = el("div", "pack");
        v.members.forEach(function (m, i) {
          if (!m.enemy) return;
          if (i) pack.appendChild(el("span", "plus", "+"));
          var count = m.min === m.max ? m.min : m.min + "-" + m.max;
          pack.appendChild(D.sprite((ICON[m.enemy] || {}).icon, 2));
          pack.appendChild(el("span", null, count + "x " + m.enemy));
        });
        vars.appendChild(el("div", "var", [el("span", "w", "w" + v.weight), pack]));
      });

      var budget = r.groups_max
        ? r.groups_min + "-" + r.groups_max + " groups"
            + (r.scale_with_size ? " × size" : ", fixed")
        : "no enemy budget";
      return el("article", "card", [head, vars, el("p", "note", budget)]);
    }
  });
})();
</script>
</body>
</html>
