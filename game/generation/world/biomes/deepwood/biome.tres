[sub_resource type="Resource" id="boss"]
script = ExtResource("fixed_encounter")
leader = ExtResource("gnarlking")
centred = true

[sub_resource type="Resource" id="sign_professors"]
script = ExtResource("sign")
text = "This place is full of old professors too."

[sub_resource type="Resource" id="sign_gifts"]
script = ExtResource("sign")
text = "Why do researchers keep giving me stuff?"

[sub_resource type="Resource" id="sign_teleport"]
script = ExtResource("sign")
text = "Fountain teleport is the best invention ever!
These clickable maps are awesome!"

[sub_resource type="Resource" id="sign_mushrooms"]
script = ExtResource("sign")
text = "I smell mushrooms. Am I hungry?"

[sub_resource type="Resource" id="sign_mycelium"]
script = ExtResource("sign")
text = "If what I'm looking for is not here
I'll have to see if it's in the Mycelium."
reveals_biome = ExtResource("mycelium")

[sub_resource type="Resource" id="sign_mushroom_kingdom"]
script = ExtResource("sign")
text = "Mushroom Kingdom? Mycelium?"

[sub_resource type="Resource" id="sign_swarms"]
script = ExtResource("sign")
text = "I've heard of terrible swarms living beneath these woods."

[sub_resource type="Resource" id="sign_hive"]
script = ExtResource("sign")
text = "If what I'm looking for is not here
I'll have to see if it's in the Hive. I don't like insects"
reveals_biome = ExtResource("hive")

[sub_resource type="Resource" id="sign_feud"]
script = ExtResource("sign")
text = "For some reason mushrooms and insects hate each other.
This can be useful later."

[sub_resource type="Resource" id="sign_king"]
script = ExtResource("sign")
text = "All the creatures of this wood obey one king.
Finding him means finding death."
reveals = ExtResource("gnarlking")

[sub_resource type="Resource" id="sign_bow"]
script = ExtResource("sign")
text = "All must bow to the Gnarlking."
reveals = ExtResource("gnarlking")

[resource]
script = ExtResource("biome")
exit_challenge = 10
roster = Dictionary[ExtResource("creature"), int]({
ExtResource("moth"): 4,
ExtResource("grimling"): 4,
ExtResource("snake"): 4,
ExtResource("stalker"): 6,
ExtResource("moss_golem"): 6
})
boss = SubResource("boss")
room_size = 30
border_warp = 20.0
loops = 0.2
shortcuts = 0.0
passage_width = 3
rockiness = 0.12
wall_depth = 3.0
wall_variation = 4.0
presentation = ExtResource("presentation")
decoration_density = 0.04
breather_chance = 0.4
professors = 8
signs = Array[ExtResource("sign")]([SubResource("sign_professors"), SubResource("sign_gifts"), SubResource("sign_teleport"), SubResource("sign_mushrooms"), SubResource("sign_mycelium"), SubResource("sign_mushroom_kingdom"), SubResource("sign_swarms"), SubResource("sign_hive"), SubResource("sign_feud"), SubResource("sign_king"), SubResource("sign_bow")])
breather_objects = Dictionary[PackedScene, int]({
ExtResource("fountain"): 1
})
