[sub_resource type="Resource" id="sign_memory"]
script = ExtResource("sign")
text = "It looks like reading a sign can remind me of where things are.
I should keep an eye on the map after reading about something,
maybe I get some memories back."

[sub_resource type="Resource" id="sign_fountains"]
script = ExtResource("sign")
text = "Seeing a fountain allows me to teleport there.
I just have to click on it from the map."

[sub_resource type="Resource" id="sign_throw_away"]
script = ExtResource("sign")
text = "Throwing away spells does not harm the environment.
I can't keep them all."

[sub_resource type="Resource" id="sign_rare_creatures"]
script = ExtResource("sign")
text = "Some creatures are rarer than others,
but it is easier to learn spells from them."

[sub_resource type="Resource" id="sign_researchers"]
script = ExtResource("sign")
text = "Friendly researches are apparently all over the place,
what are they looking for?"

[sub_resource type="Resource" id="Resource_1ajny"]
script = ExtResource("sign")
text = "Fountains hold some kind of spatial magic. If I click on them from the map I'll return to them."
