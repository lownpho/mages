[gd_resource type="Resource" script_class="WorldResource" format=3]

[ext_resource type="Script" path="res://generation/content/biome_resource.gd" id="biome"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/attachment_infeasible/biomes/cave/biome.tres" id="cave"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/attachment_infeasible/biomes/pit/biome.tres" id="pit"]
[ext_resource type="Script" path="res://generation/content/side_biome_resource.gd" id="side_biome"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/attachment_infeasible/biomes/solo/biome.tres" id="solo"]
[ext_resource type="Script" path="res://generation/content/world_resource.gd" id="world"]

[sub_resource type="Resource" id="side_cave"]
script = ExtResource("side_biome")
biome = ExtResource("cave")
parent = ExtResource("solo")

[sub_resource type="Resource" id="side_pit"]
script = ExtResource("side_biome")
biome = ExtResource("pit")
parent = ExtResource("solo")

[resource]
script = ExtResource("world")
ideal_path = Array[ExtResource("biome")]([ExtResource("solo")])
side_biomes = Array[ExtResource("side_biome")]([SubResource("side_cave"), SubResource("side_pit")])
