[gd_resource type="Resource" script_class="WorldResource" format=3]

[ext_resource type="Script" path="res://generation/content/biome_resource.gd" id="biome"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/exit_challenge/biomes/low/biome.tres" id="low"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/exit_challenge/biomes/next/biome.tres" id="next"]
[ext_resource type="Script" path="res://generation/content/side_biome_resource.gd" id="side_biome"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/load_errors/exit_challenge/biomes/solo/biome.tres" id="solo"]
[ext_resource type="Script" path="res://generation/content/world_resource.gd" id="world"]

[sub_resource type="Resource" id="side_low"]
script = ExtResource("side_biome")
biome = ExtResource("low")
parent = ExtResource("solo")

[resource]
script = ExtResource("world")
ideal_path = Array[ExtResource("biome")]([ExtResource("solo"), ExtResource("next")])
side_biomes = Array[ExtResource("side_biome")]([SubResource("side_low")])
