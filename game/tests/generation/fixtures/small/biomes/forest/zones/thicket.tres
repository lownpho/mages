[gd_resource type="Resource" script_class="ZoneResource" format=3]

[ext_resource type="Script" path="res://characters/creature/creature_resource.gd" id="creature"]
[ext_resource type="Script" path="res://generation/content/fixed_encounter_resource.gd" id="fixed_encounter"]
[ext_resource type="Resource" path="res://characters/enemies/gnarlking/gnarlking_data.tres" id="gnarlking"]
[ext_resource type="Resource" path="res://characters/enemies/grimling/grimling_data.tres" id="grimling"]
[ext_resource type="Resource" path="res://characters/enemies/grimlord/grimlord_data.tres" id="grimlord"]
[ext_resource type="Resource" path="res://characters/enemies/owl/owl_data.tres" id="owl"]
[ext_resource type="Script" path="res://generation/content/sign_resource.gd" id="sign"]
[ext_resource type="Script" path="res://generation/content/zone_resource.gd" id="zone"]

[sub_resource type="Resource" id="miniboss_grimlord"]
script = ExtResource("fixed_encounter")
leader = ExtResource("grimlord")
escorts = Dictionary[ExtResource("creature"), int]({
ExtResource("grimling"): 2
})

[sub_resource type="Resource" id="sign_king"]
script = ExtResource("sign")
text = "The king of the forest waits."
reveals = ExtResource("gnarlking")

[resource]
script = ExtResource("zone")
route_rooms = 6
room_count = 14
roster = Dictionary[ExtResource("creature"), int]({
ExtResource("owl"): 4
})
minibosses = Array[ExtResource("fixed_encounter")]([SubResource("miniboss_grimlord")])
signs = Array[ExtResource("sign")]([SubResource("sign_king")])
