[gd_resource type="Resource" script_class="WorldResource" format=3]

[ext_resource type="Script" path="res://generation/content/biome_resource.gd" id="biome"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/small/biomes/burrow/biome.tres" id="burrow"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/small/biomes/forest/biome.tres" id="forest"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/small/biomes/hollow/biome.tres" id="hollow"]
[ext_resource type="Resource" path="res://tests/generation/fixtures/small/biomes/meadow/biome.tres" id="meadow"]
[ext_resource type="Script" path="res://generation/content/side_biome_resource.gd" id="side_biome"]
[ext_resource type="Script" path="res://generation/content/world_resource.gd" id="world"]

[sub_resource type="Resource" id="side_burrow"]
script = ExtResource("side_biome")
biome = ExtResource("burrow")
parent = ExtResource("forest")

[sub_resource type="Resource" id="side_hollow"]
script = ExtResource("side_biome")
biome = ExtResource("hollow")
parent = ExtResource("forest")

[resource]
script = ExtResource("world")
ideal_path = Array[ExtResource("biome")]([ExtResource("meadow"), ExtResource("forest")])
side_biomes = Array[ExtResource("side_biome")]([SubResource("side_burrow"), SubResource("side_hollow")])
